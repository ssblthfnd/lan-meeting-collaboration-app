{
  "name": "@lan-meeting/remote-form",
  "version": "0.1.0",
  "private": true,
  "description": "Self-contained offline HTML form template for remote participants. Plain TypeScript and DOM, no framework. Built to a single file.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ../../scripts/check-remote-form-offline.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json"
  },
  "dependencies": {
    "@lan-meeting/contracts": "0.1.0",
    "@lan-meeting/editor": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-singlefile": "^2.1.0"
  }
}
